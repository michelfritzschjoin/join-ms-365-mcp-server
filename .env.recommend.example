# ==============================================================================
# Microsoft 365 MCP Server - Recommended Configuration
# ==============================================================================
# This file contains RECOMMENDED settings for most users
# Copy this file to .env and adjust values as needed
#
# SECURITY: Never commit .env files to version control!
# ==============================================================================

# ==============================================================================
# REQUIRED: Azure AD App Registration
# ==============================================================================

# Azure AD App Client ID (REQUIRED for production)
# Create an app registration at: https://portal.azure.com/#blade/Microsoft_AAD_RegisteredApps/ApplicationsListBlade
# Leave empty to use built-in default app (development only)
# RECOMMENDED: Create your own app registration for production use
MS365_MCP_CLIENT_ID=

# Azure AD Tenant ID
# Use 'common' for multi-tenant (recommended for personal accounts)
# Use your specific tenant ID for single-tenant (recommended for organizations)
# RECOMMENDED: 'common' for most users
MS365_MCP_TENANT_ID=common

# Azure AD Client Secret (optional)
# Required only for confidential client / app-only authentication
# Not needed for device code flow (recommended for most users)
MS365_MCP_CLIENT_SECRET=

# ==============================================================================
# Authentication Options
# ==============================================================================

# Pre-existing OAuth Token (BYOT - Bring Your Own Token)
# If set, uses this token directly instead of device code flow
# Useful for automation scenarios
# RECOMMENDED: Leave empty to use device code flow
MS365_MCP_OAUTH_TOKEN=

# Azure Key Vault URL (optional - for enterprise deployments)
# Fetch secrets from Azure Key Vault instead of environment variables
# RECOMMENDED: Leave empty unless using Azure Key Vault
MS365_MCP_KEYVAULT_URL=

# Microsoft Cloud Environment
# Options: 'global' (default) or 'china' (21Vianet)
# RECOMMENDED: 'global' for most users
MS365_MCP_CLOUD_TYPE=global

# ==============================================================================
# Server Mode & Features (RECOMMENDED SETTINGS)
# ==============================================================================

# Read-only Mode - Disables all write operations
# RECOMMENDED: false (enable write operations) unless you specifically need read-only
READ_ONLY=true

# Organization Mode - Enables Teams, SharePoint, and other org features
# RECOMMENDED: true if using work/school accounts, false for personal accounts
MS365_MCP_ORG_MODE=true

# Super-Tools Mode (HIGHLY RECOMMENDED!)
# Consolidates 126+ individual tools into 10 "Super-Tools" with action parameters
# Much easier for LLMs to choose the right tool and reduces cognitive load
# Tools: email, calendar, teams, files, tasks, contacts, meetings, sharepoint, notes, assistant
# RECOMMENDED: true (enabled) - Better LLM performance and token efficiency
MS365_MCP_USE_SUPER_TOOLS=true

# Enable Discovery Tools (experimental)
# Enables deep-research, discover-project, and other AI-powered tools
# RECOMMENDED: false (disabled) unless you need advanced discovery features
MS365_MCP_ENABLE_DISCOVERY_TOOLS=false

# Tool Filtering - Regex pattern to filter available tools
# Only works when MS365_MCP_USE_SUPER_TOOLS=false
# RECOMMENDED: Leave empty (use all tools) or use Super-Tools mode instead
ENABLED_TOOLS=

# Output Format
# Options: 'toon' (30-60% token reduction) or leave empty for default JSON
# RECOMMENDED: Leave empty (default JSON) for best compatibility
MS365_MCP_OUTPUT_FORMAT=toon

# ==============================================================================
# Performance & Limits (RECOMMENDED SETTINGS)
# ==============================================================================

# Maximum results per query
# RECOMMENDED: 500 (good balance between completeness and performance)
MS365_MCP_MAX_RESULTS=500

# Maximum pages to fetch in pagination
# RECOMMENDED: 500 (prevents excessive API calls while allowing thorough searches)
MS365_MCP_MAX_PAGES=500

# Maximum concurrent tool executions
# RECOMMENDED: 5 (good balance between speed and API rate limits)
MS365_MCP_MAX_CONCURRENT_TOOLS=5

# ==============================================================================
# LLM Optimization & Search Results (RECOMMENDED SETTINGS)
# ==============================================================================

# Enable LLM optimization for search results
# Reduces token usage by 60-80% through intelligent summarization
# RECOMMENDED: true (enabled) - Significantly reduces token costs
MS365_MCP_LLM_OPTIMIZE=true

# Maximum summary length in characters
# Controls how much text is included in result summaries
# RECOMMENDED: 150 (good balance between detail and token savings)
MS365_MCP_MAX_SUMMARY_LENGTH=150

# Minimum relevance score threshold (0-100)
# Only results with relevance >= threshold are returned
# RECOMMENDED: 0 (no filter) - Let the LLM decide what's relevant
MS365_MCP_RELEVANCE_THRESHOLD=0

# Maximum items per source in LLM summaries
# Limits how many items are shown per data source category
# RECOMMENDED: 10 (prevents overwhelming results while maintaining diversity)
MS365_MCP_MAX_ITEMS_PER_SOURCE=10

# ==============================================================================
# HTTP Server & CORS Configuration
# ==============================================================================

# CORS Origins - Comma-separated list of allowed origins
# Example: "https://openwebui.yourdomain.com,https://cursor.yourdomain.com"
# RECOMMENDED: Set specific origins for production, leave empty for local development
MS365_MCP_CORS_ORIGINS=

# Rate Limiting - Window in milliseconds
# RECOMMENDED: 900000 (15 minutes) - Prevents abuse while allowing normal usage
MS365_MCP_RATE_LIMIT_WINDOW_MS=900000

# Rate Limiting - Max requests per window
# RECOMMENDED: 100 - Allows reasonable usage while preventing abuse
MS365_MCP_RATE_LIMIT_MAX_REQUESTS=100

# ==============================================================================
# Security Headers (RECOMMENDED SETTINGS)
# ==============================================================================

# X-Frame-Options
# RECOMMENDED: DENY (prevents clickjacking attacks)
MS365_MCP_X_FRAME_OPTIONS=DENY

# Referrer-Policy
# RECOMMENDED: strict-origin-when-cross-origin (balances privacy and functionality)
MS365_MCP_REFERRER_POLICY=strict-origin-when-cross-origin

# Content-Security-Policy
# RECOMMENDED: Default restrictive policy (prevents XSS attacks)
MS365_MCP_CSP=default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline';

# HSTS Max Age in seconds
# RECOMMENDED: 31536000 (1 year) - Enforces HTTPS for security
MS365_MCP_HSTS_MAX_AGE=31536000

# ==============================================================================
# Logging Configuration (RECOMMENDED SETTINGS)
# ==============================================================================

# Log Level
# Options: error, warn, info, verbose, debug, silly
# RECOMMENDED: info (good balance between detail and noise)
# Use 'debug' or 'verbose' for troubleshooting
LOG_LEVEL=info

# Log Format
# Options: text or json
# RECOMMENDED: json (better for log aggregation tools)
# Use 'text' for easier human reading
LOG_FORMAT=json

# Silent Mode - Disable console output
# RECOMMENDED: false (enabled) - Keep logs for debugging
SILENT=false

# ==============================================================================
# Query Dashboard & Analytics
# ==============================================================================

# Dashboard Password (REQUIRED to enable dashboard)
# Set a strong password to access /dashboard endpoint
# If not set, dashboard is disabled for security
# RECOMMENDED: Set a strong password if you need the dashboard
DASHBOARD_PASSWORD=

# Query Store Directory
# RECOMMENDED: ./data (default) - Standard location for data files
QUERY_STORE_DIR=./data

# Maximum queries to store
# RECOMMENDED: 100000 (allows comprehensive analytics without excessive storage)
QUERY_STORE_MAX_QUERIES=100000

# Query retention period in days
# RECOMMENDED: 90 (GDPR compliance, balances analytics needs with privacy)
QUERY_STORE_RETENTION_DAYS=90

# ==============================================================================
# Learning & Knowledge Base (RECOMMENDED SETTINGS)
# ==============================================================================

# Knowledge Base File Path
# RECOMMENDED: ./data/knowledge-base.json (standard location)
MS365_MCP_KNOWLEDGE_BASE_PATH=./data/knowledge-base.json

# Enable Learning System
# Learns from search operations to improve future results
# RECOMMENDED: true (enabled) - Improves search quality over time
MS365_MCP_LEARNING_ENABLED=true

# Enable Pattern Clustering
# Groups similar query patterns together for better recommendations
# RECOMMENDED: true (enabled) - Improves pattern recognition
MS365_MCP_LEARNING_CLUSTER_ENABLED=true

# Enable Advanced NLP Features
# Enables improved NLP features like stemming, entity recognition, intent classification
# RECOMMENDED: true (enabled) - Better understanding of user queries
MS365_MCP_LEARNING_NLP_ENABLED=true

# ==============================================================================
# Self-Repair System (RECOMMENDED SETTINGS)
# ==============================================================================

# Enable Graph API Self-Repair
# Automatically attempts to repair failed Graph API requests
# RECOMMENDED: true (enabled) - Improves reliability and reduces manual intervention
MS365_MCP_ENABLE_SELF_REPAIR=true

# Maximum repair attempts per request
# RECOMMENDED: 3 (good balance between persistence and avoiding infinite loops)
MS365_MCP_MAX_REPAIR_ATTEMPTS=3

# Enabled repair strategies (comma-separated)
# Available: endpoint, parameter, scope, version, ratelimit
# RECOMMENDED: All strategies enabled for maximum reliability
MS365_MCP_REPAIR_STRATEGIES=endpoint,parameter,scope,version,ratelimit

# ==============================================================================
# Thinking Process (Transparent Reasoning) - RECOMMENDED SETTINGS
# ==============================================================================

# Enable Thinking Process
# Shows reasoning steps in OpenWebUI and other compatible clients
# RECOMMENDED: true (enabled) - Provides transparency and helps debugging
MS365_MCP_THINKING_ENABLED=true

# Thinking Level
# Options: 'minimal' (decisions only), 'normal' (default), 'verbose' (all details)
# RECOMMENDED: normal (good balance between detail and verbosity)
# Use 'verbose' for deep debugging, 'minimal' for cleaner output
MS365_MCP_THINKING_LEVEL=normal

# ==============================================================================
# Node.js Environment
# ==============================================================================

# Node Environment
# Options: 'development', 'production', 'test'
# RECOMMENDED: 'production' for deployed instances, 'development' for local dev
NODE_ENV=production

# ==============================================================================
# Timezone Configuration
# ==============================================================================

# Timezone for date/time calculations
# IMPORTANT: Set this to your local timezone for correct date handling
# Examples: Europe/Berlin, America/New_York, Asia/Tokyo
# List: https://en.wikipedia.org/wiki/List_of_tz_database_time_zones
# RECOMMENDED: Set to your local timezone
TZ=Europe/Berlin
