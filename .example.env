# ==============================================================================
# Microsoft 365 MCP Server - Environment Variables Configuration
# ==============================================================================
# Copy this file to .env and configure your values
# Never commit .env files to version control!

# ==============================================================================
# Authentication & Azure Configuration
# ==============================================================================

# Azure AD App Registration - Client ID
# Leave empty to use built-in default app
MS365_MCP_CLIENT_ID=

# Azure AD Tenant ID
# Use 'common' for multi-tenant (default) or specific tenant ID
MS365_MCP_TENANT_ID=common

# Azure AD Client Secret (optional)
# Required only for app-only authentication scenarios
# Not needed for device code flow authentication
MS365_MCP_CLIENT_SECRET=

# Microsoft Cloud Environment
# Options: 'global' (default) or 'china' (21Vianet)
MS365_MCP_CLOUD_TYPE=global

# Pre-existing OAuth Token (BYOT - Bring Your Own Token)
# If set, uses this token directly instead of device code flow
# Format: Bearer token string
MS365_MCP_OAUTH_TOKEN=

# Azure Key Vault URL (optional)
# If set, secrets will be fetched from Azure Key Vault instead of environment variables
# Format: https://your-vault-name.vault.azure.net/
# Secret names in Key Vault:
#   - ms365-mcp-client-id (required)
#   - ms365-mcp-tenant-id (optional, defaults to 'common')
#   - ms365-mcp-client-secret (optional)
#   - ms365-mcp-cloud-type (optional, defaults to 'global')
MS365_MCP_KEYVAULT_URL=

# ==============================================================================
# Server Mode & Behavior
# ==============================================================================

# Read-only mode - Disables all write operations
# Options: 'true', '1', or leave empty for false
READ_ONLY=

# Organization/Work Mode - Enables Teams, SharePoint, and other org features
# Options: 'true', '1', or leave empty for false
MS365_MCP_ORG_MODE=

# Force Work Scopes (deprecated, use MS365_MCP_ORG_MODE instead)
# Backwards compatibility alias for MS365_MCP_ORG_MODE
MS365_MCP_FORCE_WORK_SCOPES=

# Enabled Tools - Filter tools using regex pattern
# Example: "excel|contact" enables only Excel and Contact tools
# Leave empty to enable all tools
ENABLED_TOOLS=

# Output Format
# Options: 'toon' (experimental, 30-60% token reduction) or leave empty for default
MS365_MCP_OUTPUT_FORMAT=

# Enable Discovery Tools (experimental)
# Enables intelligent discovery tools (deep-research, discover-project, etc.)
# Options: 'true', '1', or leave empty for false
MS365_MCP_ENABLE_DISCOVERY_TOOLS=

# ==============================================================================
# Performance & Limits
# ==============================================================================

# Maximum results per query
# Default: 500
MS365_MCP_MAX_RESULTS=500

# Maximum aggregate items
# Default: 500
MS365_MCP_MAX_AGGREGATE_ITEMS=500

# Maximum pages to fetch in pagination
# Default: 500
MS365_MCP_MAX_PAGES=500

# Maximum concurrent tool executions
# Default: 5
MS365_MCP_MAX_CONCURRENT_TOOLS=5

# Deep Research Configuration
# Maximum research depth
# Default: 5
MS365_MCP_DEEP_RESEARCH_MAX_DEPTH=5

# Maximum research iterations
# Default: 5
MS365_MCP_MAX_RESEARCH_ITERATIONS=5

# Items per research iteration
# Default: 100
MS365_MCP_DEEP_RESEARCH_ITEMS_PER_ITERATION=100

# Maximum query variants for refinement
# Default: 5
MS365_MCP_MAX_QUERY_VARIANTS=5

# Stop on error in tool combiner
# If true, stops execution when a tool fails
# Options: 'true', '1', or leave empty for false
MS365_MCP_STOP_ON_ERROR=

# ==============================================================================
# HTTP Server Configuration (when using --http mode)
# ==============================================================================

# CORS Configuration
# Comma-separated list of allowed origins
# Example: "https://example.com,https://app.example.com"
# Leave empty to disable CORS (most secure)
MS365_MCP_CORS_ORIGINS=

# Legacy CORS Origin (single origin or '*')
# Use MS365_MCP_CORS_ORIGINS for multiple origins
MS365_MCP_CORS_ORIGIN=

# Allowed HTTP methods for CORS
# Default: "GET, POST, PUT, DELETE, OPTIONS"
MS365_MCP_CORS_METHODS=GET, POST, PUT, DELETE, OPTIONS

# Allowed headers for CORS
# Default: "Origin, X-Requested-With, Content-Type, Accept, Authorization, mcp-protocol-version"
MS365_MCP_CORS_HEADERS=Origin, X-Requested-With, Content-Type, Accept, Authorization, mcp-protocol-version

# Exposed headers in CORS responses
# Default: "X-RateLimit-Limit, X-RateLimit-Remaining, X-RateLimit-Reset"
MS365_MCP_CORS_EXPOSED_HEADERS=X-RateLimit-Limit, X-RateLimit-Remaining, X-RateLimit-Reset

# CORS preflight cache max age (in seconds)
# Default: 86400 (24 hours)
MS365_MCP_CORS_MAX_AGE=86400

# Rate Limiting
# Rate limit window in milliseconds
# Default: 900000 (15 minutes)
MS365_MCP_RATE_LIMIT_WINDOW_MS=900000

# Maximum requests per rate limit window
# Default: 100
MS365_MCP_RATE_LIMIT_MAX_REQUESTS=100

# ==============================================================================
# Security Headers
# ==============================================================================

# X-Frame-Options header
# Options: 'DENY', 'SAMEORIGIN', 'ALLOW-FROM <uri>'
# Default: 'DENY'
MS365_MCP_X_FRAME_OPTIONS=DENY

# Referrer-Policy header
# Options: 'no-referrer', 'no-referrer-when-downgrade', 'origin', 'origin-when-cross-origin', 
#          'same-origin', 'strict-origin', 'strict-origin-when-cross-origin', 'unsafe-url'
# Default: 'strict-origin-when-cross-origin'
MS365_MCP_REFERRER_POLICY=strict-origin-when-cross-origin

# Permissions-Policy header
# Controls browser features access
# Default: 'geolocation=(), microphone=(), camera=()'
MS365_MCP_PERMISSIONS_POLICY=geolocation=(), microphone=(), camera=()

# Content-Security-Policy header
# Controls resource loading and script execution
# Default: "default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline';"
MS365_MCP_CSP=default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline';

# HSTS Max Age (in seconds)
# Only applied when HTTPS is detected
# Default: 31536000 (1 year)
MS365_MCP_HSTS_MAX_AGE=31536000

# ==============================================================================
# Logging Configuration
# ==============================================================================

# Log Level
# Options: 'error', 'warn', 'info', 'verbose', 'debug', 'silly'
# Default: 'info'
LOG_LEVEL=info

# Log Format
# Options: 'text' (default) or 'json'
LOG_FORMAT=text

# Silent Mode - Disable console output
# Options: 'true', '1', or leave empty for false
SILENT=

# ==============================================================================
# Learning & Knowledge Base
# ==============================================================================

# Enable Learning System
# If disabled, the system won't learn from search operations
# Options: 'false', '0' to disable, or leave empty/any other value to enable
MS365_MCP_LEARNING_ENABLED=

# Knowledge Base File Path
# Path to the knowledge base JSON file
# Default: ./data/knowledge-base.json (relative to project root)
MS365_MCP_KNOWLEDGE_BASE_PATH=./data/knowledge-base.json

# Learning Time Decay Configuration
# Patterns older than this number of days will lose weight
# Default: 90 days
MS365_MCP_LEARNING_DECAY_DAYS=90

# Learning Decay Factor
# Decay factor per month (0.0 - 1.0)
# Default: 0.1 (10% decay per month)
MS365_MCP_LEARNING_DECAY_FACTOR=0.1

# Minimum Confidence Score
# Patterns below this confidence score will be deprioritized
# Default: 0.5
MS365_MCP_LEARNING_MIN_CONFIDENCE=0.5

# Enable Pattern Clustering
# Groups similar query patterns together for better recommendations
# Options: 'true' to enable, 'false' or leave empty to disable
# Default: enabled
MS365_MCP_LEARNING_CLUSTER_ENABLED=true

# Enable Advanced NLP Features
# Enables improved NLP features like stemming, entity recognition, intent classification
# Options: 'true' to enable, 'false' or leave empty to disable
# Default: enabled
MS365_MCP_LEARNING_NLP_ENABLED=true

# ==============================================================================
# Self-Repair System
# ==============================================================================

# Enable Graph API Self-Repair System
# Automatically attempts to repair failed Graph API requests using various strategies
# Options: 'true' to enable, 'false' or leave empty to disable
# Default: disabled
MS365_MCP_ENABLE_SELF_REPAIR=

# Maximum Repair Attempts
# Maximum number of repair attempts per request
# Default: 3
MS365_MCP_MAX_REPAIR_ATTEMPTS=3

# Enabled Repair Strategies
# Comma-separated list of repair strategies to enable
# Available strategies: endpoint, parameter, scope, version, ratelimit
# Default: endpoint,parameter,scope,version,ratelimit
# Example: MS365_MCP_REPAIR_STRATEGIES=endpoint,parameter,scope
MS365_MCP_REPAIR_STRATEGIES=endpoint,parameter,scope,version,ratelimit

# ==============================================================================
# Node.js Environment
# ==============================================================================

# Node Environment
# Options: 'development', 'production', 'test'
# Default: 'production'
NODE_ENV=production

