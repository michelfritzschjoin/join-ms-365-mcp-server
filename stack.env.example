# ==============================================================================
# Microsoft 365 MCP Server - Stack Environment Configuration
# ==============================================================================
# Copy this file to stack.env and configure your values
# This file is used with docker-compose.yml
#
# SECURITY: Never commit stack.env to version control!
# ==============================================================================

# ==============================================================================
# REQUIRED: Azure AD App Registration
# ==============================================================================

# Azure AD App Client ID (REQUIRED for production)
# Create an app registration at: https://portal.azure.com/#blade/Microsoft_AAD_RegisteredApps/ApplicationsListBlade
# Leave empty to use built-in default app (development only)
MS365_MCP_CLIENT_ID=

# Azure AD Tenant ID
# Use 'common' for multi-tenant or your specific tenant ID
# Example: 12345678-1234-1234-1234-123456789abc
MS365_MCP_TENANT_ID=common

# Azure AD Client Secret (optional)
# Required only for confidential client / app-only authentication
# Not needed for device code flow
MS365_MCP_CLIENT_SECRET=

# ==============================================================================
# Authentication Options
# ==============================================================================

# Pre-existing OAuth Token (BYOT - Bring Your Own Token)
# If set, uses this token directly instead of device code flow
# Useful for automation scenarios
MS365_MCP_OAUTH_TOKEN=

# Azure Key Vault URL (optional - for enterprise deployments)
# Fetch secrets from Azure Key Vault instead of environment variables
# Format: https://your-vault-name.vault.azure.net/
MS365_MCP_KEYVAULT_URL=

# Microsoft Cloud Environment
# Options: 'global' (default) or 'china' (21Vianet)
MS365_MCP_CLOUD_TYPE=global

# ==============================================================================
# Server Mode & Features
# ==============================================================================

# Read-only Mode - Disables all write operations
# Set to 'true' for read-only access to Microsoft 365 data
READ_ONLY=false

# Organization Mode - Enables Teams, SharePoint, and other org features
# Set to 'true' if using work/school accounts with org features
MS365_MCP_ORG_MODE=false

# Super-Tools Mode (Recommended for LLMs!)
# Consolidates 126+ individual tools into 10 "Super-Tools" with action parameters
# Much easier for LLMs to choose the right tool and reduces cognitive load
# Tools: email, calendar, teams, files, tasks, contacts, meetings, sharepoint, notes, assistant
MS365_MCP_USE_SUPER_TOOLS=true

# Enable Discovery Tools (experimental)
# Enables deep-research, discover-project, and other AI-powered tools
MS365_MCP_ENABLE_DISCOVERY_TOOLS=false

# Tool Filtering - Regex pattern to filter available tools
# Example: "mail|calendar" enables only Mail and Calendar tools
# Leave empty to enable all tools (only works when MS365_MCP_USE_SUPER_TOOLS=false)
ENABLED_TOOLS=

# Output Format
# Options: 'toon' (30-60% token reduction) or leave empty for default JSON
MS365_MCP_OUTPUT_FORMAT=

# ==============================================================================
# Performance & Limits
# ==============================================================================

# Maximum results per query (default: 500)
MS365_MCP_MAX_RESULTS=500

# Maximum pages to fetch in pagination (default: 500)
MS365_MCP_MAX_PAGES=500

# Maximum concurrent tool executions (default: 5)
MS365_MCP_MAX_CONCURRENT_TOOLS=5

# ==============================================================================
# LLM Optimization & Search Results
# ==============================================================================

# Enable LLM optimization for search results (default: true)
# Reduces token usage by 60-80% through intelligent summarization
# Set to 'false' to disable optimization and return full results
MS365_MCP_LLM_OPTIMIZE=true

# Maximum summary length in characters (default: 150)
# Controls how much text is included in result summaries
MS365_MCP_MAX_SUMMARY_LENGTH=150

# Minimum relevance score threshold (0-100, default: 0 = no filter)
# Only results with relevance >= threshold are returned
# Higher values = more strict filtering, fewer but higher quality results
MS365_MCP_RELEVANCE_THRESHOLD=0

# Maximum items per source in LLM summaries (default: 10)
# Limits how many items are shown per data source category
MS365_MCP_MAX_ITEMS_PER_SOURCE=10

# ==============================================================================
# HTTP Server & CORS Configuration
# ==============================================================================

# CORS Origins - Comma-separated list of allowed origins
# Example: "https://openwebui.yourdomain.com,https://cursor.yourdomain.com"
# Leave empty to disable CORS (most restrictive)
# Use "*" to allow all origins (not recommended for production)
MS365_MCP_CORS_ORIGINS=

# Rate Limiting - Window in milliseconds (default: 900000 = 15 minutes)
MS365_MCP_RATE_LIMIT_WINDOW_MS=900000

# Rate Limiting - Max requests per window (default: 100)
MS365_MCP_RATE_LIMIT_MAX_REQUESTS=100

# ==============================================================================
# Security Headers
# ==============================================================================

# X-Frame-Options (default: DENY)
MS365_MCP_X_FRAME_OPTIONS=DENY

# Referrer-Policy (default: strict-origin-when-cross-origin)
MS365_MCP_REFERRER_POLICY=strict-origin-when-cross-origin

# Content-Security-Policy
MS365_MCP_CSP=default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline';

# HSTS Max Age in seconds (default: 31536000 = 1 year)
MS365_MCP_HSTS_MAX_AGE=31536000

# ==============================================================================
# Logging Configuration
# ==============================================================================

# Log Level: error, warn, info, verbose, debug, silly
LOG_LEVEL=info

# Log Format: text or json
LOG_FORMAT=json

# Silent Mode - Disable console output
SILENT=false

# ==============================================================================
# Query Dashboard & Analytics
# ==============================================================================

# Dashboard Password (REQUIRED to enable dashboard)
# Set a strong password to access /dashboard endpoint
# If not set, dashboard is disabled for security
DASHBOARD_PASSWORD=

# Query Store Directory (default: ./data)
# Where query logs are stored
QUERY_STORE_DIR=./data

# Maximum queries to store (default: 100000)
QUERY_STORE_MAX_QUERIES=100000

# Query retention period in days (default: 90, GDPR compliance)
QUERY_STORE_RETENTION_DAYS=90

# ==============================================================================
# Learning & Knowledge Base
# ==============================================================================

# Knowledge Base File Path (relative to /app in container)
MS365_MCP_KNOWLEDGE_BASE_PATH=/app/data/knowledge-base.json

# Enable Learning System
MS365_MCP_LEARNING_ENABLED=true

# Enable Pattern Clustering
MS365_MCP_LEARNING_CLUSTER_ENABLED=true

# Enable Advanced NLP Features
MS365_MCP_LEARNING_NLP_ENABLED=true

# ==============================================================================
# Automatic Query Optimization
# ==============================================================================

# Enable automatic query optimization before search execution
# Applies learned patterns, synonym expansion, and query normalization
MS365_MCP_AUTO_QUERY_OPTIMIZATION_ENABLED=true

# Minimum confidence threshold to apply an optimization (0.0 - 1.0)
MS365_MCP_QUERY_OPTIMIZATION_CONFIDENCE_THRESHOLD=0.6

# Minimum pattern occurrences before learning is applied
MS365_MCP_QUERY_OPTIMIZATION_MIN_PATTERN_COUNT=2

# ==============================================================================
# Self-Repair System
# ==============================================================================

# Enable Graph API Self-Repair (auto-fix failed requests)
MS365_MCP_ENABLE_SELF_REPAIR=true

# Maximum repair attempts per request (default: 3)
MS365_MCP_MAX_REPAIR_ATTEMPTS=3

# Enabled repair strategies (comma-separated)
# Available: endpoint, parameter, scope, version, ratelimit
MS365_MCP_REPAIR_STRATEGIES=endpoint,parameter,scope,version,ratelimit

# ==============================================================================
# Thinking Process (Transparent Reasoning)
# ==============================================================================

# Enable Thinking Process - Shows reasoning steps in OpenWebUI
# Set to 'false' to disable thinking process output
MS365_MCP_THINKING_ENABLED=true

# Thinking Level - Controls detail of reasoning output
# Options: 'minimal' (decisions only), 'normal' (default), 'verbose' (all details)
MS365_MCP_THINKING_LEVEL=normal

# ==============================================================================
# Node.js Environment
# ==============================================================================

# Node Environment (production recommended for Docker)
NODE_ENV=production

