{
  "name": "join-ms-365-mcp-server",
  "version": "1.23.3",
  "description": " A Model Context Protocol (MCP) server for interacting with Microsoft 365 and Office services through the Graph API",
  "type": "module",
  "main": "dist/index.js",
  "bin": {
    "ms-365-mcp-server": "dist/index.js"
  },
  "scripts": {
    "generate": "node bin/generate-graph-client.mjs",
    "patch-client": "node bin/patch-generated-client.mjs",
    "predev": "node bin/check-generated.mjs",
    "predev:http": "node bin/check-generated.mjs",
    "build": "tsup",
    "pretypecheck": "node bin/patch-generated-client.mjs",
    "typecheck": "tsc --noEmit",
    "test": "npm run typecheck && npm run lint && npm run format:check && npm run test:security && npm run test:unit && npm run test:integration",
    "test:security": "npm run security:audit && npm run security:check && npm run security:verify",
    "test:pre-check": "npm run lint && npm run format:check",
    "test:pre-check:full": "npm run typecheck && npm run lint && npm run format:check",
    "security:audit": "audit-ci --config .audit-ci.json",
    "security:check": "npm audit --audit-level=critical",
    "security:verify": "npm audit --production --audit-level=critical",
    "security:fix": "npm audit fix",
    "test:unit": "npm run fix-tool-descriptions && npm run optimize-tool-descriptions && npm run patch-client && vitest run --reporter=verbose",
    "test:integration": "npm run patch-client && vitest run --reporter=verbose --config vitest.config.js",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "test:coverage:html": "vitest run --coverage && echo Coverage report generated in ./coverage/index.html",
    "test:all": "npm run test:pre-check && npm run test:unit && npm run test:integration && npm run test:coverage",
    "test:ci": "npm run test:pre-check && npm run patch-client && vitest run --coverage --reporter=json --reporter=verbose --outputFile=./test-results.json",
    "fix-tool-descriptions": "node bin/fix-tool-descriptions.mjs",
    "optimize-tool-descriptions": "node bin/optimize-tool-descriptions.mjs",
    "dev": "tsx src/index.ts",
    "dev:http": "tsx --watch src/index.ts --http 0.0.0.0:3000 -v",
    "format": "prettier --write \"**/*.{ts,mts,js,mjs,json,md}\"",
    "format:check": "prettier --check \"**/*.{ts,mts,js,mjs,json,md}\"",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "verify": "npm run generate && npm run lint && npm run format:check && npm run build && npm run test",
    "inspector": "npx @modelcontextprotocol/inspector tsx src/index.ts",
    "prepare": "husky",
    "release": "semantic-release",
    "release:dry-run": "semantic-release --dry-run",
    "commitlint": "commitlint --edit"
  },
  "keywords": [
    "microsoft",
    "365",
    "mcp",
    "server"
  ],
  "author": "",
  "license": "All Rights Reserved",
  "publishConfig": {
    "access": "public"
  },
  "dependencies": {
    "@azure/msal-node": "^5.0.2",
    "@modelcontextprotocol/sdk": "^1.25.3",
    "@toon-format/toon": "^2.1.0",
    "@types/bcrypt": "^6.0.0",
    "bcrypt": "^6.0.0",
    "commander": "^14.0.2",
    "dotenv": "^17.2.3",
    "express": "^5.2.1",
    "express-rate-limit": "^8.2.1",
    "hono": "^4.12.14",
    "js-yaml": "^4.1.1",
    "jszip": "^3.10.1",
    "mammoth": "^1.11.0",
    "winston": "^3.19.0",
    "zod": "^4.3.6"
  },
  "optionalDependencies": {
    "@azure/identity": "^4.13.0",
    "@azure/keyvault-secrets": "^4.10.0",
    "keytar": "^7.9.0"
  },
  "devDependencies": {
    "@commitlint/cli": "^20.3.1",
    "@commitlint/config-conventional": "^20.3.1",
    "@redocly/cli": "^2.17.0",
    "@semantic-release/changelog": "^6.0.3",
    "@semantic-release/exec": "^7.1.0",
    "@semantic-release/git": "^10.0.1",
    "@semantic-release/github": "^12.0.2",
    "@semantic-release/npm": "^13.1.3",
    "@types/express": "^5.0.6",
    "@types/node": "^25.0.10",
    "@typescript-eslint/eslint-plugin": "^8.53.1",
    "@typescript-eslint/parser": "^8.53.1",
    "@vitest/coverage-v8": "^4.0.18",
    "audit-ci": "^7.1.0",
    "conventional-changelog-conventionalcommits": "^9.1.0",
    "eslint": "^9.39.2",
    "globals": "^17.1.0",
    "husky": "^9.1.7",
    "prettier": "^3.8.1",
    "semantic-release": "^25.0.2",
    "tsup": "^8.5.1",
    "tsx": "^4.21.0",
    "typescript": "^5.9.3",
    "vitest": "^4.0.18",
    "yaml": "^2.8.2"
  },
  "engines": {
    "node": ">=18"
  },
  "overrides": {
    "fast-xml-parser": "^5.3.4"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/michelfritzschjoin/join-ms-365-mcp-server.git"
  }
}
